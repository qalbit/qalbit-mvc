# Copy to `.env.local` for development or `.env.production` on the server.
# Empty values are treated as unset (see lib/env.ts).

# --- Site & SEO ---
SITE_URL=https://qalbit.com
NEXT_PUBLIC_SITE_URL=
INDEXING_ENABLED=false
NEXT_PUBLIC_GTM_ID=
GSC_VERIFICATION=
NEXT_PUBLIC_GA4_ID=

# --- reCAPTCHA (contact + career forms) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
EMAIL_FROM=info@qalbit.com
EMAIL_FROM_NAME=QalbIT
EMAIL_TO_SALES=sales@qalbit.com
EMAIL_TO_HR=hr@qalbit.com
EMAIL_TO_BCC=

# --- Slack (form notifications) ---
SLACK_WEBHOOK_URL=

# --- WordPress blog (WPGraphQL) ---
WP_GRAPHQL_URL=
WP_GRAPHQL_AUTH=

# --- Tawk.to live chat (optional) ---
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=

# --- Form deduplication window (ms) ---
DEDUPE_WINDOW_MS=300000

# --- Node environment (set by Next.js in most cases) ---
# NODE_ENV=development
